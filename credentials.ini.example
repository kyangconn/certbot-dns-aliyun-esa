# Required. Use a RAM user with only the ESA permissions documented in README.md.
dns_aliyun_esa_access_key_id = your_access_key_id
dns_aliyun_esa_access_key_secret = your_access_key_secret

# Optional. Omit this line to discover the ESA site from each certificate domain.
# dns_aliyun_esa_site_id = 1234567890
